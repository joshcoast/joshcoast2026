# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Core
#
# Note: if you want to stage/commit WP core files
# you can delete this whole section/until Configuration.
/wp-admin/
/wp-content/index.php
/wp-content/languages
/wp-content/plugins/index.php
/wp-content/themes/index.php
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php

# Configuration
wp-config.php

# Example themes
/wp-content/themes/twenty*/

# Uploads
/wp-content/uploads/

# Log files
*.log

# htaccess
/.htaccess

# Plugins
#
# Plugins are tracked by default so custom plugins are picked up automatically.
# Add one-off ignore rules below only for third-party plugins you do not want in git.
# Recipe:
# 1) Untrack once: git rm -r --cached wp-content/plugins/<plugin-slug>
# 2) Ignore future changes by adding:
#    /wp-content/plugins/<plugin-slug>/

# Third-party plugins (ignored)
/wp-content/plugins/advanced-custom-fields/
/wp-content/plugins/akismet/
/wp-content/plugins/all-in-one-wp-migration/
/wp-content/plugins/generateblocks/
/wp-content/plugins/generateblocks-pro/
/wp-content/plugins/wordpress-beta-tester/
**/node_modules/
**/build/

# All themes
#
# Note: If you wish to whitelist themes,
# uncomment the next line
#/wp-content/themes

*.DS_Store
/wp-content/wpvividbackups/
/wp-content/ai1wm-backups/

# Backup plugin files
/wp-content/ai1wm-backups/
/wp-content/wpvividbackups/
/wp-content/plugins/all-in-one-wp-migration/storage/
/wp-content/mu-plugins/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/wflogs/
*.DS_Store

# Local dev files
local-xdebuginfo.php

# Stray files in wp-content
/wp-content/*.png
/wp-content/*.xz
/wp-content/*.zip
/wp-content/debug.log*
/wp-content/fatal-error-handler.php
/wp-content/temp-write-test-*
/wp-content/README.md

# Plugin-generated directories
/wp-content/jetpack-waf/
/wp-content/settings/
/wp-content/smush-webp/
/wp-content/wpvivid_staging/

# Theme build outputs (generated by webpack in CI)
/wp-content/themes/jc-theme-switcher/assets/css/*.min.css
